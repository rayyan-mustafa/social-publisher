# ==============================================================================
# SOCIAL PUBLISHER — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Reddit API Credentials (Create "script" app at https://www.reddit.com/prefs/apps)
# Unlimited Free tier (100 queries/min)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# X (Twitter) API v2 (Get keys at https://developer.x.com/en/portal/dashboard)
# Free tier: 500 tweets/month ($0)
TWITTER_API_KEY=your_twitter_consumer_key
TWITTER_API_SECRET=your_twitter_consumer_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# LinkedIn REST API (Get at https://developer.linkedin.com/)
# 100% Free Developer tier
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_PERSON_URN=
